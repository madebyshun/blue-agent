# Inference — Virtuals (https://compute.virtuals.io/v1)
VIRTUALS_API_KEY=your_virtuals_api_key_here
# Optional. Must be an id that exists in the live Virtuals catalog — an unknown
# id returns 400, not a fallback. Defaults to deepseek-deepseek-v4-flash.
# VIRTUALS_MODEL=deepseek-deepseek-v4-flash

# Blue Agent paid tools. Override only if you are self-hosting.
BLUEAGENT_API_URL=https://blueagent.dev

# EVM private key used to pay x402 invoices in USDC on Base. Never commit this.
WALLET_PRIVATE_KEY=your_private_key_here
