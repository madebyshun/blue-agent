{
  "name": "@blueagent/x402",
  "version": "0.3.2",
  "description": "x402 client SDK for Blue Hub \u2014 pay-per-call AI tools on Base",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "blueagent-x402-mcp": "dist/mcp-stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp-stdio.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/mcp-stdio.ts --format cjs,esm --dts --watch",
    "mcp:stdio": "tsx src/mcp-stdio.ts"
  },
  "keywords": [
    "x402",
    "base",
    "usdc",
    "ai",
    "blueagent",
    "blue-hub",
    "payments"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyshun/blue-agent.git",
    "directory": "packages/x402-client"
  },
  "homepage": "https://blueagent.dev",
  "bugs": {
    "url": "https://github.com/madebyshun/blue-agent/issues"
  }
}
